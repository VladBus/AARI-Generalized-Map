# Скопируйте в .env и заполните параметры SMTP.
# Сетевые каталоги задаются UNC-путями, чтобы проект было проще перенести на другой ПК.
AARI_SOURCE_ROOT=\\10.31.34.60\Tiris\МОРЕ\ОБОБЩЕНКА_ОТПРАВКА
AARI_MORE_ROOT=\\10.31.34.60\Tiris\МОРЕ
AARI_ICE_CHARTS_ROOT=\\files.aari.ru\Ice_charts
AARI_MORSPASS_ROOT=\\files.aari.ru\morspass
AARI_SOVBEZ_ROOT=\\files.aari.ru\sovbez
AARI_ICECHARTS_V_ROOT=\\10.31.34.110\C373\IceCharts
AARI_LVP_WAVE_ROOT=\\10.31.34.60\Tiris\LVP_WAVE
AARI_WEBSITE_ROOT=\\data.aari.ru\d0015\arctic

# SMTP — настройки общего почтового ящика ЦЛГМИ «Север».
AARI_SMTP_SERVER=zmail.aari.ru
AARI_SMTP_PORT=25
AARI_SMTP_SECURITY=auto
AARI_SMTP_AUTH_MODE=auto
AARI_SMTP_USERNAME=sever@aari.ru
# При security=auto порт 465 использует SMTP_SSL, для других портов STARTTLS включается,
# если сервер его предлагает. Без STARTTLS пароль не отправляется; без авторизации
# возможна попытка relay, которую сервер может разрешить или запретить.
# Необязательно: путь к доверенному CA-сертификату PEM для проверки сертификата.
# AARI_SMTP_CA_FILE=C:/certificates/aari-mail-ca.pem
AARI_EMAIL_ADDRESS=sever@aari.ru
AARI_EMAIL_NAME=Центр ледовой и гидрометеорологической информации «Север»
# В режиме auth=auto пустой пароль означает подключение без SMTP AUTH.
# Если сервер требует авторизацию, он вернёт отказ, который появится в журнале.
# При необходимости можно задать auth_mode=required и пароль.
AARI_MAIL_PASSWORD=

# Получатели еженедельного отчёта в 15:00 по средам.
# Разделяйте адреса запятыми или точкой с запятой; список можно свободно менять.
AARI_REPORT_RECIPIENTS=Sat_info@aari.ru

# Проверка размера: широкий диапазон нужен только для выявления явных аномалий.
AARI_SIZE_MIN_RATIO=0.35
AARI_SIZE_MAX_RATIO=2.5
AARI_LOG_LEVEL=INFO

# Необязательно: по умолчанию STATUS.txt и aari_generalized_map.log лежат
# прямо в AARI_SOURCE_ROOT.
# AARI_STATUS_FILE=
# AARI_LOG_FILE=
